<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HYPER BET BD</title>
<style>
  :root{
    --bg:#0a0f1c; --panel:#121a2b; --panel2:#0e1524;
    --text:#eaf0ff; --sub:#8fa0c2; --line:#1e2a44;
    --accent:#5ec8ff; --gold:#ffc857; --danger:#ff6161; --win:#5ee6a0; --purple:#b98bff;
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); height:100%; }
  body{
    height:100%; margin:0; background:var(--bg); color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    display:flex; justify-content:center; overflow-x:hidden;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#f4f6fb; --panel:#ffffff; --panel2:#eef1f8;
      --text:#111827; --sub:#5b6786; --line:#dde3f0;
    }
  }
  .wrap{ width:100%; max-width:460px; padding:18px 16px 28px; }
