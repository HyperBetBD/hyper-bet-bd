          </div>
          <div class="stat">
            <div class="v" id="statGames">0</div>
            <div class="k">TOTAL ROUND -</div>
          </div>
          <div class="stat">
            <div class="v" id="statWins">0</div>
            <div class="k">WIN</div>
          </div>
        </div>
      </div>

      <div class="panel">
        <h2 class="section">HISTORY</h2>
        <div class="history" id="history"></div>
      </div>

      <div class="panel">
        <h2 class="section">REDEM YOUR CODE -</h2>
        <div class="row">
          <input
            class="bet-input"
