<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Cache-Control"
      content="no-cache, no-store, must-revalidate"
    />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>HYPER BET BD</title>
    <link rel="icon" href="data:," />
    <style>
      :root {
        --bg: #0a0f1c;
        --panel: #121a2b;
        --panel2: #0e1524;
        --text: #eaf0ff;
        --sub: #8fa0c2;
        --line: #1e2a44;
        --accent: #5ec8ff;
        --gold: #ffc857;
        --danger: #ff6161;
        --win: #5ee6a0;
        --purple: #b98bff;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      html {
        scroll-padding-top: env(safe-area-inset-top, 0px);
        height: 100%;
      }
      body {
        height: 100%;
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        justify-content: center;
        overflow-x: hidden;
      }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) {
          --bg: #f4f6fb;
          --panel: #ffffff;
          --panel2: #eef1f8;
          --text: #111827;
          --sub: #5b6786;
          --line: #dde3f0;
        }
      }
      .wrap {
        width: 100%;
        max-width: 460px;
        padding: 18px 16px 28px;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 14px;
      }
      header h1 {
        font-size: 1.3rem;
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      header p {
        margin: 2px 0 0;
        color: var(--sub);
        font-size: 0.8rem;
      }
      .balance {
        text-align: right;
      }
      .balance .amt {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--gold);
        transition: transform 0.2s;
      }
      .balance .lbl {
        font-size: 0.72rem;
        color: var(--sub);
      }
      .balance.pulse .amt {
        animation: pulseAmt 0.5s ease;
      }
      @keyframes pulseAmt {
        0% {
          transform: scale(1);
        }
        40% {
          transform: scale(1.18);
        }
        100% {
          transform: scale(1);
        }
      }

      .stage {
        background: linear-gradient(
          180deg,
          var(--panel) 0%,
          var(--panel2) 100%
        );
        border: 1px solid var(--line);
        border-radius: 18px;
        height: 270px;
        position: relative;
        overflow: hidden;
        margin-bottom: 14px;
        isolation: isolate;
        transition:
          background 0.5s ease,
          box-shadow 0.2s;
      }
      .stage::before {
        content: "";
        position: absolute;
        inset: -30%;
        z-index: -2;
        pointer-events: none;
        background:
          radial-gradient(
            circle at 18% 26%,
            rgba(112, 226, 255, 0.3) 0 1px,
            transparent 2px
          ),
          radial-gradient(
            circle at 74% 18%,
            rgba(255, 255, 255, 0.3) 0 1px,
            transparent 2px
          ),
          radial-gradient(
            circle at 86% 68%,
            rgba(255, 200, 87, 0.32) 0 1px,
            transparent 2px
          ),
          radial-gradient(
            ellipse at 50% 104%,
            rgba(94, 200, 255, 0.28),
            transparent 57%
          );
        background-size:
          130px 100px,
          190px 140px,
          240px 180px,
          100% 100%;
        animation: skyDrift 16s linear infinite alternate;
      }
      .stage::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          linear-gradient(
            115deg,
            transparent 0 42%,
            rgba(94, 200, 255, 0.1) 48%,
            transparent 54%
          ),
          linear-gradient(180deg, transparent 0 68%, rgba(8, 14, 28, 0.3));
        background-size:
          180% 100%,
          100% 100%;
        animation: skyBeam 8s ease-in-out infinite alternate;
      }
      .stage.sky-cyan {
        background: linear-gradient(180deg, #142b4b 0%, #0b1428 100%);
      }
      .stage.sky-violet {
        background: linear-gradient(180deg, #29204d 0%, #10152f 100%);
      }
      .stage.sky-sunset {
        background: linear-gradient(
          180deg,
          #442744 0%,
          #19182f 48%,
          #0d1427 100%
        );
      }
      .stage.sky-aurora {
        background: linear-gradient(
          180deg,
          #123d4d 0%,
          #122341 45%,
          #0a1225 100%
        );
      }
      .stage.flying {
        background:
          radial-gradient(
            circle at 50% 45%,
            rgba(44, 91, 145, 0.34),
            transparent 40%
          ),
          #05070d;
      }
      .stage.flying::before {
        inset: -65%;
        opacity: 0.9;
        background: repeating-conic-gradient(
          from -18deg at 50% 53%,
          rgba(255, 255, 255, 0.13) 0deg 1deg,
          transparent 1deg 8deg
        );
        background-size: auto;
        animation: burstSpin 18s linear infinite;
        -webkit-mask-image: radial-gradient(
          ellipse at 50% 50%,
          black 0 34%,
          transparent 74%
        );
        mask-image: radial-gradient(
          ellipse at 50% 50%,
          black 0 34%,
          transparent 74%
        );
      }
      .stage.flying::after {
        background:
          radial-gradient(
            ellipse at 50% 48%,
            rgba(78, 139, 207, 0.25),
            transparent 35%
          ),
          linear-gradient(
            105deg,
            transparent 0 43%,
            rgba(255, 255, 255, 0.08) 48%,
            transparent 53%
          );
        background-size:
          100% 100%,
          180% 100%;
        animation: skyBeam 5s ease-in-out infinite alternate;
      }
      .stage.crashed {
        background:
          radial-gradient(
            circle at 50% 45%,
            rgba(170, 18, 50, 0.42),
            transparent 44%
          ),
          #09060d;
      }
      @keyframes burstSpin {
        to {
          transform: rotate(360deg);
        }
      }
      @keyframes skyDrift {
        from {
          transform: translate3d(0, 0, 0) scale(1);
        }
        to {
          transform: translate3d(18px, -8px, 0) scale(1.05);
        }
      }
      @keyframes skyBeam {
        from {
          background-position:
            -70% 0,
            0 0;
        }
        to {
          background-position:
            70% 0,
            0 0;
        }
      }
      .stage.shake {
        animation: shakeStage 0.4s;
      }
      @keyframes shakeStage {
        0%,
        100% {
          transform: translateX(0);
        }
        20% {
          transform: translateX(-6px);
        }
        40% {
          transform: translateX(5px);
        }
        60% {
          transform: translateX(-4px);
        }
        80% {
          transform: translateX(3px);
        }
      }
      .flash {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
      }
      .flash.win {
        background: radial-gradient(
          circle at 50% 55%,
          rgba(94, 230, 160, 0.35),
          transparent 70%
        );
      }
      .flash.crash {
        background: radial-gradient(
          circle at 50% 55%,
          rgba(255, 97, 97, 0.4),
          transparent 70%
        );
      }
      .flash.show {
        animation: flashFade 0.7s ease-out;
      }
      @keyframes flashFade {
        0% {
          opacity: 1;
        }
        100% {
          opacity: 0;
        }
      }

      .cloud {
        position: absolute;
        font-size: 1.4rem;
        opacity: 0.35;
        animation: driftCloud 14s linear infinite;
      }
      @keyframes driftCloud {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-40px);
        }
      }

      .trail {
        position: absolute;
        height: 3px;
        border-radius: 3px;
        background: linear-gradient(90deg, transparent, var(--accent));
        opacity: 0.5;
        transform-origin: right center;
      }

      .mult {
        position: absolute;
        top: 44%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        transition: color 0.2s;
      }
      .mult.pre {
        color: var(--sub);
        font-size: 1.3rem;
        text-shadow:
          0 0 6px rgba(0, 0, 0, 0.9),
          0 0 2px rgba(0, 0, 0, 1);
      }
      .stage.waiting .mult.pre {
        animation: countdownPulse 1s ease-in-out infinite;
      }
      @keyframes countdownPulse {
        0%,
        100% {
          transform: translate(-50%, -50%) scale(0.96);
          opacity: 0.72;
        }
        50% {
          transform: translate(-50%, -50%) scale(1.14);
          opacity: 1;
          color: var(--accent);
          text-shadow:
            0 0 18px rgba(94, 200, 255, 0.8),
            0 0 3px #fff;
        }
      }
      .mult.live {
        color: var(--accent);
        text-shadow:
          0 0 10px rgba(94, 200, 255, 0.85),
          0 2px 4px rgba(0, 0, 0, 0.9);
      }
      .mult.live.tier2 {
        color: var(--purple);
        text-shadow:
          0 0 10px rgba(185, 139, 255, 0.85),
          0 2px 4px rgba(0, 0, 0, 0.9);
      }
      .mult.live.tier3 {
        color: var(--gold);
        text-shadow:
          0 0 14px rgba(255, 200, 87, 0.9),
          0 2px 4px rgba(0, 0, 0, 0.9);
      }
      .mult.crash {
        color: var(--danger);
        text-shadow:
          0 0 12px rgba(255, 97, 97, 0.9),
          0 2px 4px rgba(0, 0, 0, 0.9);
      }
      .mult.cashed {
        color: var(--win);
        text-shadow:
          0 0 12px rgba(94, 230, 160, 0.9),
          0 2px 4px rgba(0, 0, 0, 0.9);
      }

      .status {
        position: absolute;
        bottom: 12px;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 0.85rem;
        color: #eaf0ff;
        min-height: 1.2em;
        padding: 0 12px;
        text-shadow:
          0 1px 3px rgba(0, 0, 0, 0.95),
          0 0 6px rgba(0, 0, 0, 0.8);
        font-weight: 600;
      }
      .plane {
        position: absolute;
        left: 0;
        top: 0;
        bottom: auto;
        filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.5));
        width: 104px;
        height: 64px;
        z-index: 3;
        transform-origin: 42% 54%;
        will-change: transform;
      }
      .plane.idle {
        animation: bobPlane 2s ease-in-out infinite;
      }
      @keyframes bobPlane {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-6px);
        }
      }
      .plane-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
        user-select: none;
        filter: drop-shadow(0 6px 5px rgba(0, 0, 0, 0.55));
      }
      .plane.crashed .plane-image {
        filter: grayscale(1) brightness(0.56)
          drop-shadow(0 5px 4px rgba(0, 0, 0, 0.65));
      }
      .plane.mega .plane-image {
        filter: drop-shadow(0 0 8px var(--gold))
          drop-shadow(0 0 15px rgba(255, 200, 87, 0.65));
      }
      .skin-light {
        position: absolute;
        z-index: 2;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #ffe9aa;
        border: 1px solid rgba(255, 255, 255, 0.88);
        box-shadow:
          0 0 4px 2px #fff3a7,
          0 0 11px 4px rgba(255, 76, 88, 0.78);
        animation: skinNavBlink 0.72s steps(2, end) infinite;
        pointer-events: none;
      }
      .skin-light.wing-left {
        left: 39%;
        top: 61%;
      }
      .skin-light.wing-right {
        left: 67%;
        top: 58%;
        animation-delay: -0.38s;
      }
      .skin-light.nose {
        left: 89%;
        top: 39%;
        width: 8px;
        height: 8px;
        background: #fff8cf;
        animation-delay: -0.18s;
      }
      @keyframes skinNavBlink {
        0%,
        38% {
          opacity: 0.18;
          transform: scale(0.68);
        }
        39%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
      }
      .exhaust-flame {
        transform-origin: 50% 50%;
        animation: exhaustPulse 0.16s ease-in-out infinite alternate;
      }
      .exhaust-flame.two {
        animation-delay: -0.08s;
      }
      .exhaust-core {
        fill: #fff4a3;
      }
      .exhaust-outer {
        fill: #ff7b38;
        opacity: 0.9;
      }
      .exhaust-spark {
        fill: #ffe7a0;
        animation: sparkFly 0.55s ease-out infinite;
      }
      .exhaust-spark.two {
        animation-delay: -0.27s;
      }
      @keyframes exhaustPulse {
        from {
          transform: scale(0.72) translateX(1px);
          opacity: 0.65;
        }
        to {
          transform: scale(1.08) translateX(-2px);
          opacity: 1;
        }
      }
      @keyframes sparkFly {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 1;
        }
        100% {
          transform: translate(-13px, 5px) scale(0.1);
          opacity: 0;
        }
      }
      #planeEmoji,
      #planeImg {
        display: none !important;
      }
      .beacon {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--danger);
        box-shadow: 0 0 6px 2px rgba(255, 97, 97, 0.9);
        animation: beaconBlink 1s ease-in-out infinite;
      }
      @keyframes beaconBlink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.15;
        }
      }
      .stage.mega {
        box-shadow: inset 0 0 40px rgba(255, 200, 87, 0.35);
      }
      .mega-badge {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--gold);
        color: #241a00;
        font-weight: 800;
        font-size: 0.72rem;
        padding: 3px 10px;
        border-radius: 20px;
        opacity: 0;
        transition: opacity 0.3s;
      }
      .mega-badge.show {
        opacity: 1;
      }
      .stage.waiting::before {
        border: 1px solid rgba(94, 200, 255, 0.2);
        border-radius: 50%;
        inset: 24% 27%;
        box-shadow:
          0 0 0 12px rgba(94, 200, 255, 0.035),
          0 0 35px rgba(94, 200, 255, 0.08);
        animation: countdownHalo 2s ease-in-out infinite;
      }
      @keyframes countdownHalo {
        0%,
        100% {
          transform: scale(0.9);
          opacity: 0.35;
        }
        50% {
          transform: scale(1.08);
          opacity: 0.9;
        }
      }

      /* Music light: animated colour beams + equalizer bars (behind the plane) */
      .music-lights {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .music-lights .beam {
        position: absolute;
        top: -20%;
        width: 34%;
        height: 140%;
        opacity: 0.18;
        filter: blur(10px);
        transform-origin: 50% 0;
        mix-blend-mode: screen;
        animation: beamSweep 3.2s ease-in-out infinite alternate,
          beamPulse 0.9s ease-in-out infinite alternate;
        will-change: transform, opacity;
      }
      .music-lights .beam.b1 {
        left: 4%;
        background: linear-gradient(180deg, rgba(255, 60, 140, 0.9), transparent 75%);
      }
      .music-lights .beam.b2 {
        left: 33%;
        background: linear-gradient(180deg, rgba(94, 200, 255, 0.9), transparent 75%);
        animation-delay: -1.1s, -0.3s;
      }
      .music-lights .beam.b3 {
        left: 62%;
        background: linear-gradient(180deg, rgba(185, 139, 255, 0.9), transparent 75%);
        animation-delay: -2.1s, -0.6s;
      }
      .music-lights .eq {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 34px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 3px;
        padding: 0 6px;
        opacity: 0.55;
      }
      .music-lights .eq i {
        flex: 1;
        height: 100%;
        border-radius: 3px 3px 0 0;
        background: linear-gradient(180deg, #ffc857, #ff3c8c 55%, #5ec8ff);
        transform-origin: 50% 100%;
        transform: scaleY(0.2);
        animation: eqBounce 0.7s ease-in-out infinite alternate;
        will-change: transform;
      }
      .music-lights .eq i:nth-child(3n) { animation-duration: 0.55s; animation-delay: -0.2s; }
      .music-lights .eq i:nth-child(3n + 1) { animation-duration: 0.85s; animation-delay: -0.45s; }
      .music-lights .eq i:nth-child(4n) { animation-duration: 0.62s; animation-delay: -0.1s; }
      @keyframes beamSweep {
        from { transform: rotate(-14deg); }
        to { transform: rotate(14deg); }
      }
      @keyframes beamPulse {
        from { opacity: 0.1; }
        to { opacity: 0.3; }
      }
      @keyframes eqBounce {
        from { transform: scaleY(0.12); }
        to { transform: scaleY(0.95); }
      }
      @media (prefers-reduced-motion: reduce) {
        .music-lights .beam, .music-lights .eq i { animation: none; }
      }
      .mode-strip {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
        height: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #120900;
        background: linear-gradient(90deg, #c77800, #ffc52e, #c77800);
        font-size: 0.52rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        box-shadow: 0 1px 0 rgba(255, 222, 114, 0.4);
      }
      .flight-route {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.35s ease;
        overflow: visible;
      }
      .flight-route .route-shadow {
        fill: none;
        stroke: #26000f;
        stroke-width: 20;
        opacity: 0.75;
      }
      .flight-route .route-glow {
        fill: none;
        stroke: #ff124c;
        stroke-width: 13;
        opacity: 0.22;
        filter: blur(7px);
      }
      .flight-route .route-main {
        fill: none;
        stroke: url(#routeGradient);
        stroke-width: 8;
        stroke-linecap: round;
      }
      .stage.flying .flight-route {
        opacity: 1;
      }
      .flight-route .route-shadow,
      .flight-route .route-glow,
      .flight-route .route-main {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
      }
      .stage.crashed .flight-route {
        opacity: 0.6;
      }
      .stage.flying .plane {
        filter: drop-shadow(0 0 5px rgba(255, 20, 76, 0.75))
          drop-shadow(0 4px 5px rgba(0, 0, 0, 0.6));
      }

      .float-coin {
        position: absolute;
        font-weight: 800;
        font-size: 1rem;
        color: var(--win);
        animation: floatUp 1s ease-out forwards;
        pointer-events: none;
      }
      @keyframes floatUp {
        0% {
          opacity: 1;
          transform: translateY(0);
        }
        100% {
          opacity: 0;
          transform: translateY(-40px);
        }
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 12px;
      }
      .row {
        display: flex;
        gap: 10px;
        align-items: center;
      }
      .bet-input {
        flex: 1;
        background: var(--panel2);
        border: 1px solid var(--line);
        color: var(--text);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 1rem;
        font-weight: 600;
        -moz-appearance: textfield;
      }
      .bet-input::-webkit-outer-spin-button,
      .bet-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
      }
      .chip {
        background: var(--panel2);
        border: 1px solid var(--line);
        color: var(--sub);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
      }
      .chip:active {
        transform: scale(0.96);
      }
      .chips {
        display: flex;
        gap: 6px;
        margin-top: 8px;
      }

      button.main {
        width: 100%;
        margin-top: 12px;
        padding: 15px;
        border: none;
        border-radius: 12px;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition:
          transform 0.08s,
          opacity 0.2s;
      }
      button.main:active {
        transform: scale(0.98);
      }
      button.main[disabled] {
        opacity: 0.4;
        cursor: default;
        transform: none;
      }
      .btn-bet {
        background: var(--accent);
        color: #04101c;
      }
      .btn-cash {
        background: var(--gold);
        color: #241a00;
      }
      .btn-queued {
        background: var(--panel2);
        color: var(--sub);
        border: 1px solid var(--line);
      }

      .stats {
        display: flex;
        justify-content: space-between;
        gap: 8px;
      }
      .stat {
        flex: 1;
        background: var(--panel2);
        border-radius: 10px;
        padding: 10px;
        text-align: center;
      }
      .stat .v {
        font-weight: 700;
        font-size: 1rem;
      }
      .stat .k {
        font-size: 0.68rem;
        color: var(--sub);
        margin-top: 2px;
      }

      .history {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      .hchip {
        padding: 5px 9px;
        border-radius: 8px;
