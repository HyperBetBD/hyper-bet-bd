            type="text"
            placeholder="e.g. 100-4821"
            inputmode="numeric"
          />
        </div>
        <button class="main btn-bet" id="redeemBtn" style="margin-top: 8px">
          CONFROM REDEM
        </button>
        <p
          id="redeemMsg"
          style="
            font-size: 0.78rem;
            color: var(--sub);
            text-align: center;
            margin: 8px 0 0;
          "
        ></p>
      </div>

      <div class="panel">
        <h2 class="section">REMOVE COIN</h2>
        <div class="row">
          <input
            class="bet-input"
            id="subtractInput"
            type="number"
            min="1"
            placeholder="ENTER AMOUNT "
            inputmode="numeric"
          />
        </div>
        <button
          class="main btn-queued"
          id="subtractBtn"
          style="margin-top: 8px"
        >
          CONFROM REMOVE
        </button>
        <p
          id="subtractMsg"
          style="
            font-size: 0.78rem;
            color: var(--sub);
            text-align: center;
            margin: 8px 0 0;
          "
        ></p>
      </div>

      <button class="chip" id="resetBtn" style="width: 100%; margin-top: 2px">
        RESET COIN -
      </button>

      <p class="note">BANGLADESHI TOP TRUSTED FAIRPLAY SITE GO FOR BIG WIN</p>
    </div>

    <script>
      (function () {
        const KEY = "hyperBetBdState_v2";
        function load() {
          try {
            const raw = localStorage.getItem(KEY);
            if (raw) return JSON.parse(raw);
          } catch (e) {}
          return {
            balance: 0,
            best: 1.0,
            games: 0,
            wins: 0,
            history: [],
            redeemedCodes: [],
          };
        }
        function save() {
          try {
            if (Array.isArray(state.history) && state.history.length > 50) {
              state.history = state.history.slice(0, 50);
            }
            localStorage.setItem(KEY, JSON.stringify(state));
          } catch (e) {}
        }

        let state = load();
        if (!Array.isArray(state.redeemedCodes)) state.redeemedCodes = [];

        const balanceAmt = document.getElementById("balanceAmt");
        const balanceBox = document.getElementById("balanceBox");
        const multDisplay = document.getElementById("multDisplay");
        const statusText = document.getElementById("statusText");
        const actionBtn = document.getElementById("actionBtn");
        const betInput = document.getElementById("betInput");
        const plane = document.getElementById("plane");
        const stage = document.getElementById("stage");
        const flash = document.getElementById("flash");
        const trail = document.getElementById("trail");
        const megaBadge = document.getElementById("megaBadge");
        const routePaths = Array.from(
          document.querySelectorAll(".flight-route path"),
        );
        const routeMain = document.querySelector(".flight-route .route-main");
        const routeLength = routeMain ? routeMain.getTotalLength() : 1000;

        function resetFlightRoute() {
          routePaths.forEach((path) => {
            path.style.strokeDasharray = routeLength.toFixed(2);
            path.style.strokeDashoffset = routeLength.toFixed(2);
          });
        }

        function revealFlightRoute(progress) {
          const visible = Math.max(
            0,
            Math.min(routeLength, progress * routeLength),
          );
          const offset = routeLength - visible;
          routePaths.forEach((path) => {
            path.style.strokeDasharray = routeLength.toFixed(2);
            path.style.strokeDashoffset = offset.toFixed(2);
          });
          return visible;
        }

        // The background remains CSS-only so a GitHub Pages upload of this single file cannot break.
        const SKY_BACKGROUNDS = [];

        function setRandomBackground() {
          stage.classList.remove(
            "sky-cyan",
            "sky-violet",
            "sky-sunset",
            "sky-aurora",
          );
          const skins = ["sky-cyan", "sky-violet", "sky-sunset", "sky-aurora"];
          stage.classList.add(skins[Math.floor(Math.random() * skins.length)]);
          stage.style.backgroundImage = "";
        }

        function setPlaneVisual(kind) {
          // idle | flying | crashed
          plane.classList.remove("idle", "crashed");
          if (kind === "idle") plane.classList.add("idle");
          if (kind === "crashed") plane.classList.add("crashed");
        }
        const statBest = document.getElementById("statBest");
        const statGames = document.getElementById("statGames");
        const statWins = document.getElementById("statWins");
        const historyEl = document.getElementById("history");
        const redeemInput = document.getElementById("redeemInput");
        const redeemBtn = document.getElementById("redeemBtn");
        const redeemMsg = document.getElementById("redeemMsg");
        const subtractInput = document.getElementById("subtractInput");
        const subtractBtn = document.getElementById("subtractBtn");
        const subtractMsg = document.getElementById("subtractMsg");
        const resetBtn = document.getElementById("resetBtn");

        const WAIT_MS = 6000;
        const CRASH_SHOW_MS = 2200;

        // Single source of truth for game phase, guarded by roundId so stale
        // timers from a previous round can never affect a newer one.
        let roundId = 0;
        let phase = "waiting"; // waiting | flying | crashed
        let phaseStart = performance.now();
        let crashPoint = 1;
        let queuedBet = null; // amount queued to enter the NEXT flying phase
        let activeBet = null; // { amount, cashed, cashMult } for the CURRENT flying round
        let rafId = null;
        let stageW = 0,
          stageH = 0; // cached stage pixel size, refreshed each flight

        function render() {
          balanceAmt.textContent = Math.round(state.balance);
          statBest.textContent = state.best.toFixed(2) + "x";
          statGames.textContent = state.games;
          statWins.textContent = state.wins;
          historyEl.innerHTML =
            state.history
              .slice(0, 10)
              .map((h) => {
                const cls = h.win ? "win" : "lose";
                const label = h.win
                  ? "+" + h.amount + "  " + h.mult.toFixed(2) + "x"
                  : "-" + h.amount + "  " + h.mult.toFixed(2) + "x";
                return '<span class="hchip ' + cls + '">' + label + "</span>";
              })
              .join("") ||
            '<span style="color:var(--sub); font-size:0.8rem;">ZERO ROUND</span>';
        }

        function pulseBalance() {
          balanceBox.classList.remove("pulse");
          void balanceBox.offsetWidth;
          balanceBox.classList.add("pulse");
        }

        function flashEffect(kind) {
          flash.className = "flash " + kind;
          void flash.offsetWidth;
          flash.classList.add("show");
        }

        function floatCoin(text, x, y, color) {
          const el = document.createElement("div");
          el.className = "float-coin";
          el.textContent = text;
          el.style.left = x + "%";
          el.style.bottom = y + "%";
          el.style.color = color;
          stage.appendChild(el);
          setTimeout(() => el.remove(), 1000);
        }

        document.querySelectorAll(".chip[data-amt]").forEach((c) => {
          c.addEventListener("click", () => {
            betInput.value = c.getAttribute("data-amt");
          });
        });

        // Each local 100-round cycle contains exactly the requested category counts.
        // The order is shuffled once per cycle and persisted, so every device gets the
        // same odds distribution without tying the result to the bet amount.
        const RANDOM_MODE_KEY = "hyperBetBdRandomMode_v1";
        const RANDOM_BUCKETS = [
          { count: 12, min: 2, max: 7.99, label: "2x-7.99x" },
          { count: 24, min: 1, max: 1.09, label: "1x-1.09x" },
          { count: 23, min: 1, max: 1.45, label: "1x-1.45x" },
          { count: 20, min: 1.45, max: 2.04, label: "1.45x-2.04x" },
          { count: 10, min: 8, max: 20, label: "8x-20x" },
          { count: 8, min: 20, max: 100, label: "20x-100x" },
          { count: 3, min: 80, max: 1000, label: "80x-1000x" },
        ];

        function shuffle(values) {
          for (let i = values.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [values[i], values[j]] = [values[j], values[i]];
          }
          return values;
        }

        function makeRandomCycle() {
          const values = [];
          RANDOM_BUCKETS.forEach((bucket) => {
            for (let i = 0; i < bucket.count; i++) {
              const raw =
                bucket.min + Math.random() * (bucket.max - bucket.min);
              values.push({
                value: Number(raw.toFixed(2)),
                label: bucket.label,
              });
            }
          });
          return { index: 0, values: shuffle(values) };
        }

        function loadRandomCycle() {
          try {
            const saved = JSON.parse(
              localStorage.getItem(RANDOM_MODE_KEY) || "null",
            );
            if (
              saved &&
              Array.isArray(saved.values) &&
              saved.values.length === 100 &&
              Number.isInteger(saved.index) &&
              saved.index >= 0 &&
              saved.index <= 100
            ) {
              return saved;
            }
          } catch (e) {}
          return makeRandomCycle();
        }

        function saveRandomCycle() {
          try {
            localStorage.setItem(RANDOM_MODE_KEY, JSON.stringify(randomCycle));
          } catch (e) {}
        }

        let randomCycle = loadRandomCycle();

        function nextCrashPoint() {
          if (randomCycle.index >= randomCycle.values.length) {
            randomCycle = makeRandomCycle();
          }
          const next = randomCycle.values[randomCycle.index++];
          saveRandomCycle();
          return next.value;
        }

        function currentMultiplier() {
          if (phase !== "flying") return 1;
          const elapsed = performance.now() - phaseStart;
          return Math.pow(1.00013, elapsed);
        }

        // ---- Phase transitions ----

        function startWaiting() {
          roundId++;
          const myRound = roundId;
          phase = "waiting";
          phaseStart = performance.now();
          activeBet = null;
          stage.classList.add("waiting");
          stage.classList.remove("flying", "crashed");
          trail.style.display = "none";
          resetFlightRoute();
          setPlaneVisual("idle");
          setRandomBackground();
          stage.classList.remove("mega");
          megaBadge.classList.remove("show");
          plane.style.left = "12%";
          plane.style.top = "auto";
          plane.style.bottom = "18%";
          plane.style.transform = "";
          multDisplay.className = "mult pre";

          if (queuedBet) {
            actionBtn.textContent = "CANCEL BET (" + queuedBet + " COIN ADDED)";
            actionBtn.className = "main btn-queued";
          } else {
            actionBtn.textContent = "PLACE BET (NEXT FLIGHT)";
            actionBtn.className = "main btn-bet";
          }
          actionBtn.disabled = false;
          betInput.disabled = !!queuedBet;

          tickWaiting(myRound);
        }

        function tickWaiting(myRound) {
          if (myRound !== roundId) return;
          const remain = Math.max(
            0,
            WAIT_MS - (performance.now() - phaseStart),
          );
          const secs = Math.ceil(remain / 1000);
          multDisplay.textContent = secs + "s";
          statusText.textContent = queuedBet
            ? "BET ADDED (" + queuedBet + " COIN) — GO FOR FLY..."
            : "PLACE A BET, OR SKIP THIS ROUND";

          if (remain <= 0) {
            startFlying(myRound);
          } else {
            requestAnimationFrame(() => tickWaiting(myRound));
          }
        }

        function startFlying(myRound) {
          if (myRound !== roundId) return;
          phase = "flying";
          phaseStart = performance.now();
          stage.classList.remove("waiting", "crashed");
          stage.classList.add("flying");
          stage.classList.remove("waiting");
          crashPoint = nextCrashPoint();
          setPlaneVisual("flying");
          multDisplay.className = "mult live";
          trail.style.display = "none";

          // Fix the plane's base left/bottom once, then only ever move it via
          // CSS transform for the rest of the flight — transform is GPU-composited
          // and doesn't trigger layout recalculation every frame, which is what
          // caused the earlier shaky/jittery motion on slower phones.
          stageW = stage.clientWidth;
          stageH = stage.clientHeight;
          plane.style.left = "0px";
          plane.style.top = "0px";
          plane.style.bottom = "auto";
          plane.style.transform = "";

          if (queuedBet) {
            const bet = queuedBet;
            queuedBet = null;
            if (bet > state.balance) {
              statusText.textContent = "YOU HAVE NOT ENOUGH COIN";
              actionBtn.disabled = true;
            } else {
              activeBet = { amount: bet, cashed: false, cashMult: 0 };
              state.balance -= bet;
              save();
              pulseBalance();
              render();
              actionBtn.textContent = "CASH OUT -";
              actionBtn.className = "main btn-cash";
              actionBtn.disabled = false;
              statusText.textContent = "FLYING WAIT FOR BIG WIN";
            }
          } else {
            actionBtn.textContent = "GO FOR NEXT FLIGHT ";
            actionBtn.className = "main btn-bet";
            actionBtn.disabled = true;
            statusText.textContent = "FLYING GO FOR NEXT ROUND";
          }
          betInput.disabled = true;

          tickFlying(myRound);
        }

        function tickFlying(myRound) {
          if (myRound !== roundId) return;
          const current = currentMultiplier();

          if (current >= crashPoint) {
            crashRound(myRound, crashPoint);
            return;
          }

          multDisplay.textContent = current.toFixed(2) + "x";
          multDisplay.className =
            "mult live" +
            (current >= 5 ? " tier3" : current >= 2 ? " tier2" : "");

          if (current >= 20) {
            stage.classList.add("mega");
            plane.classList.add("mega");
            megaBadge.classList.add("show");
          }

          const elapsedSec = (performance.now() - phaseStart) / 1000;
          // The multiplier controls progress along the same SVG curve used by the
          // red trail. This keeps the plane, line, height, and tilt in one smooth
          // coordinate system instead of making them move independently.
          const pct = Math.min(0.88, Math.log(current + 0.001) / Math.log(60));
          const routeProgress = 0.05 + (pct / 0.88) * 0.84;
          const visibleLength = revealFlightRoute(routeProgress);
          const point = routeMain.getPointAtLength(visibleLength);
          const nextPoint = routeMain.getPointAtLength(
            Math.min(routeLength, visibleLength + 3),
          );
          const scaleX = stageW / 460;
          const scaleY = stageH / 270;
          const x = point.x * scaleX - plane.offsetWidth * 0.42;
          const y = point.y * scaleY - plane.offsetHeight * 0.54;
          const angle =
            (Math.atan2(
              (nextPoint.y - point.y) * scaleY,
              (nextPoint.x - point.x) * scaleX,
            ) *
              180) /
            Math.PI;

          plane.style.transform =
            "translate(" +
            x.toFixed(1) +
            "px, " +
            y.toFixed(1) +
            "px) rotate(" +
            angle.toFixed(1) +
            "deg)";

          rafId = requestAnimationFrame(() => tickFlying(myRound));
        }

        function cashOut() {
          if (phase !== "flying" || !activeBet || activeBet.cashed) return;
          const mult = Math.min(currentMultiplier(), crashPoint - 0.001);
          const winnings = Math.round(activeBet.amount * mult);

          activeBet.cashed = true;
          activeBet.cashMult = mult;

          state.balance += winnings;
          state.games += 1;
          state.wins += 1;
          if (mult > state.best) state.best = mult;
          state.history.unshift({ win: true, amount: winnings, mult: mult });
          save();
          pulseBalance();
          render();

          flashEffect("win");
          floatCoin("+" + winnings, 55, 55, "var(--win)");

          actionBtn.textContent = "CASHED OUT ✓";
          actionBtn.className = "main btn-queued";
          actionBtn.disabled = true;
          statusText.textContent =
            mult.toFixed(2) + "x CASH OUT AMOUNT  +" + winnings + " COIN";
        }

        function crashRound(myRound, finalMult) {
          if (myRound !== roundId) return;
          cancelAnimationFrame(rafId);
          phase = "crashed";
          phaseStart = performance.now();
          stage.classList.remove("flying", "waiting");
          stage.classList.add("crashed");

          multDisplay.textContent = finalMult.toFixed(2) + "x";
          multDisplay.className = "mult crash";
          setPlaneVisual("crashed");
          plane.classList.remove("mega");
          stage.classList.remove("mega");
          megaBadge.classList.remove("show");
          stage.classList.add("shake");
          setTimeout(() => stage.classList.remove("shake"), 400);

          if (activeBet && !activeBet.cashed) {
            state.games += 1;
            state.history.unshift({
              win: false,
              amount: activeBet.amount,
              mult: finalMult,
            });
            save();
            render();
            flashEffect("crash");
            statusText.textContent =
              "CRASHED! " + activeBet.amount + " COIN LOST";
          } else if (activeBet && activeBet.cashed) {
            statusText.textContent = "CASH OUT DONE ALREADY";
          } else {
            statusText.textContent =
              "CRASHED at " +
              finalMult.toFixed(2) +
              "x — you did not play this round";
          }

          actionBtn.disabled = true;

          setTimeout(() => {
            if (myRound !== roundId) return;
            startWaiting();
          }, CRASH_SHOW_MS);
        }

        // ---- Bet queue / cash-out button ----
        // A short lock after every tap prevents mobile browsers that fire both a
        // touch and a click event from double-processing the same action (the
        // likely cause of "balance deducted but not credited" glitches before).
        let actionLock = false;

        actionBtn.addEventListener("click", () => {
          if (actionLock) return;
          actionLock = true;
          setTimeout(() => {
            actionLock = false;
          }, 300);

          if (phase === "flying" && activeBet && !activeBet.cashed) {
            cashOut();
            return;
          }
          if (phase === "waiting") {
            if (queuedBet) {
              queuedBet = null;
              actionBtn.textContent = "GO FOR NEXT FLIGHT ";
              actionBtn.className = "main btn-bet";
              betInput.disabled = false;
              statusText.textContent = "FLY CANCELLED";
            } else {
              const bet = Math.floor(Number(betInput.value));
              if (!bet || bet < 1) {
                statusText.textContent = "MINIMUM 1 COIN";
                return;
              }
              if (bet > 85000) {
                statusText.textContent = "HIGEST 85000 COIN";
                return;
              }
              if (bet > state.balance) {
                statusText.textContent = "YOU HAVE NOT ENOUGH COIN";
                return;
              }
              queuedBet = bet;
              actionBtn.textContent = "CANCEL FLY (" + bet + " COIN ADDED)";
              actionBtn.className = "main btn-queued";
              betInput.disabled = true;
              statusText.textContent = "WAIT FOR FLY";
            }
          }
        });

        // Dynamic code system: any code is just "<amount>-<checksum>", e.g. "100-4821".
        // The checksum is derived from the amount + a shared secret (CODE_SALT) so a
        // matching code can be generated for ANY coin amount instantly, without
        // editing this file each time — use the separate code-generator tool for that.
        // Caveat: this is a static site with no server. The checksum only stops
        // casual guessing; the page's own source code (viewable by anyone) contains
        // this same formula, so it can't be made fully tamper-proof without a real
        // backend. A code can also only be redeemed once per device, not globally.
        const CODE_SALT = "hyperbetbd-secret-2026";

        function simpleHash(str) {
          let h = 0;
          for (let i = 0; i < str.length; i++) {
            h = (h * 31 + str.charCodeAt(i)) >>> 0;
          }
          return h;
        }
        function checksumFor(amount) {
          return (simpleHash(String(amount) + CODE_SALT) % 9000) + 1000;
        }
        function parseRedeemCode(raw) {
          const parts = raw.split("-");
          if (parts.length !== 2) return null;
          const amount = parseInt(parts[0], 10);
          if (!amount || amount <= 0) return null;
          if (parts[1] !== String(checksumFor(amount))) return null;
          return amount;
        }

        let redeemLock = false;
        redeemBtn.addEventListener("click", () => {
          if (redeemLock) return;
          redeemLock = true;
          setTimeout(() => {
            redeemLock = false;
          }, 300);

          const raw = redeemInput.value.trim();
          if (!raw) {
            redeemMsg.textContent = "Type your redeem code";
            return;
          }
          const amount = parseRedeemCode(raw);
          if (amount === null) {
            redeemMsg.textContent = "INVALID CODE";
            return;
          }
          if (state.redeemedCodes.includes(raw)) {
            redeemMsg.textContent = "ALREADY USED";
            return;
          }
          state.balance += amount;
          state.redeemedCodes.push(raw);
          save();
          pulseBalance();
          render();
          redeemMsg.textContent = "+" + amount + " COIN ADDED -";
          redeemInput.value = "";
        });

        let subtractLock = false;
        subtractBtn.addEventListener("click", () => {
          if (subtractLock) return;
          subtractLock = true;
          setTimeout(() => {
            subtractLock = false;
          }, 300);

          const amt = Math.floor(Number(subtractInput.value));
          if (!amt || amt <= 0) {
            subtractMsg.textContent = "TYPE CORRECT NUMBER";
            return;
          }
          if (amt > state.balance) {
            subtractMsg.textContent = "YOU HAVE NOT ENOUGH COIN";
            return;
          }
          state.balance -= amt;
          save();
          pulseBalance();
          render();
          subtractMsg.textContent = amt + " COIN REMOVED";
          subtractInput.value = "";
        });

        let resetLock = false;
        resetBtn.addEventListener("click", () => {
          if (resetLock) return;
          resetLock = true;
          setTimeout(() => {
            resetLock = false;
          }, 300);

          if (!confirm("GO FOR 0 COIN YOU READY?")) return;
          state.balance = 0;
          save();
          pulseBalance();
          render();
        });

        render();
        startWaiting();
      })();
    </script>
  </body>
</html>
