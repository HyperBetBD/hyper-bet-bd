            bottom: 16%;
            left: 20%;
            font-size: 1.1rem;
            animation-delay: -8s;
          "
        >
          ☁️
        </div>
        <div class="trail" id="trail" style="display: none"></div>
        <div class="mega-badge" id="megaBadge">
