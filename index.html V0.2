              <stop offset="0" stop-color="#a40038" />
              <stop offset=".48" stop-color="#ff164f" />
              <stop offset="1" stop-color="#ff7897" />
            </linearGradient>
          </defs>
          <path
            class="route-shadow"
            d="M-20 253 C 65 253 74 226 150 190 S 250 88 500 22"
          />
          <path
            class="route-glow"
            d="M-20 253 C 65 253 74 226 150 190 S 250 88 500 22"
          />
          <path
            class="route-main"
            d="M-20 253 C 65 253 74 226 150 190 S 250 88 500 22"
